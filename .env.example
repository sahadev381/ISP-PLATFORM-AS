# ---------------------------------------------------------------
# ISP Platform — environment configuration
# Copy to `.env` and fill in real values.  NEVER commit `.env`.
# ---------------------------------------------------------------

# Environment: production | development
APP_ENV=production
APP_DEBUG=false

# Set to true only when the site is served over HTTPS
APP_HTTPS=true

# --- Main database (RADIUS + billing) --------------------------
DB_HOST=localhost
DB_USER=radius
DB_PASS=change-me
DB_NAME=radius
DB_PORT=3306

# --- Monitoring database ---------------------------------------
MON_DB_HOST=localhost
MON_DB_USER=monitordb
MON_DB_PASS=change-me
MON_DB_NAME=monitoring

# --- Session ----------------------------------------------------
# Comma-separated IPs of reverse proxies / load balancers in front of the
# app. Only requests arriving FROM one of these have their
# X-Forwarded-For header believed. Leave empty when PHP faces the
# internet directly - otherwise anyone can forge the IP in the audit log.
TRUSTED_PROXIES=

SESSION_TIMEOUT_MINUTES=30
SESSION_IDLE_MINUTES=15

# --- Internal API access ----------------------------------------
# Long random string, e.g. `openssl rand -hex 32`
# Used by cron jobs / external integrations calling api/*.php
API_KEY=

# --- Cross-origin access ----------------------------------------
# Comma-separated exact origins allowed to call the JSON endpoints,
# e.g. https://portal.example.com,https://app.example.com
# Leave empty (the default) to send no CORS headers at all: gateway
# callbacks are server-to-server and our own pages are same-origin,
# so neither needs them. "*" is deliberately not supported.
CORS_ALLOWED_ORIGINS=

# --- GenieACS (TR-069) ------------------------------------------
GENIEACS_URL=http://127.0.0.1:7557
GENIEACS_USER=
GENIEACS_PASS=

# --- Khalti payment gateway -------------------------------------
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
KHALTI_VERIFY_URL=https://khalti.com/api/v2/payment/verify/

# --- eSewa payment gateway --------------------------------------
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=

# --- Twilio / WhatsApp alerts -----------------------------------
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
ALERT_TO=

# --- Backups ----------------------------------------------------
BACKUP_DIR=
BACKUP_RETENTION_DAYS=7
